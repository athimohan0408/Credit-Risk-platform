# Credit Risk Platform — Environment Variables
# Copy this file to .env and fill in real values before running:
#   cp .env.example .env      (Windows: copy .env.example .env)
#
# .env is git-ignored. Never commit a real key.

# ── Google Gemini API Key ─────────────────────────────────────────────────
# REQUIRED for the Talk-to-Data chatbot. Everything else (EDA, prediction,
# SHAP explanations, business rules) runs fine without it.
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Gemini model (optional) ───────────────────────────────────────────────
# Defaults to gemini-flash-lite-latest: the schema is small so a lite model is
# accurate enough, it skips the internal reasoning pass that full Flash models
# bill to the output budget, and it has a higher free-tier request rate.
# Use a `-latest` alias rather than a pinned version — pinned model IDs are
# retired periodically and the app then fails with a 404.
# GEMINI_MODEL=gemini-flash-lite-latest

# ── Data directory (optional) ─────────────────────────────────────────────
# Folder containing the Kaggle CSVs (application_train.csv, application_test.csv,
# bureau.csv). docker-compose sets this to /data_host automatically.
# If unset, the app looks in ./data/ and then in the parent directory.
# DATA_DIR=/path/to/home-credit-default-risk
